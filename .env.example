# Copia este archivo como `.env.local` y completa los valores.
# Los encuentras en Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio: omite Row Level Security. Solo se usa en el servidor
# (pedidos de invitados y alta de personal). NUNCA la expongas al navegador
# ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
